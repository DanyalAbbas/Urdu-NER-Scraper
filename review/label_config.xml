<View>
  <Style>
    .lsf-richtext__line { direction: rtl; text-align: right; }
    .lsf-text { direction: rtl; text-align: right; font-size: 20px; line-height: 2; }
  </Style>

  <Header value="Urdu NER review — fix spans if needed; no edit = approved."/>

  <Text name="text" value="$text"/>

  <Labels name="label" toName="text" allowoverlap="false">
    <Label value="PER"      background="#1f77b4"/>
    <Label value="LOC"      background="#2ca02c"/>
    <Label value="PLACE"    background="#17becf"/>
    <Label value="JOBTITLE" background="#d62728"/>
    <Label value="ORG"      background="#9467bd"/>
    <Label value="TIME"     background="#ff7f0e"/>
    <Label value="DAY"      background="#bcbd22"/>
    <Label value="EVENT"    background="#e377c2"/>
    <Label value="PHONE"    background="#7f7f7f"/>
    <Label value="CNIC"     background="#8c564b"/>
  </Labels>
</View>
